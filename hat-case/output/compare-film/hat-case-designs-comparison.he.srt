1
00:00:00,600 --> 00:00:03,852
‫שְׁתֵּי אֶפְשָׁרֻיּוֹת לְעִצּוּב הַגַּב שֶׁל הַקֻּפְסָה,‬

2
00:00:03,902 --> 00:00:06,570
‫שְׁתֵּיהֶן עִם הֶחָרִיץ הַצַּר בְּיוֹתֵר.‬

3
00:00:07,200 --> 00:00:11,524
‫מִיָּמִין, אֶפְשָׁרוּת 1: גַּב שָׁטוּחַ עַד הַדְּפָנוֹת.‬

4
00:00:11,574 --> 00:00:15,730
‫מִשְּׂמֹאל, אֶפְשָׁרוּת 2: גַּב בְּצוּרַת כִּפָּה.‬

5
00:00:15,900 --> 00:00:20,843
‫מִבַּחוּץ, בַּגַּב הַשָּׁטוּחַ, הֶחָרִיץ הוּא הַקַּו הַיָּחִיד עַל מִשְׁטָח אֶחָד.‬

6
00:00:20,893 --> 00:00:25,710
‫בַּכִּפָּה, הַגַּב מִתְעַגֵּל לְכִוּוּן הַדְּפָנוֹת, וְהַמֶּרְכָּז בּוֹלֵט.‬

7
00:00:31,400 --> 00:00:35,256
‫בִּפְנִים, הַטַּבַּעַת עוֹלָה מִן הָרִצְפָּה וְיוֹרֶדֶת חֲזָרָה.‬

8
00:00:35,306 --> 00:00:38,730
‫הַדֹּפֶן הַזֹּאת הִיא הֶחָרִיץ שֶׁרוֹאִים מִבַּחוּץ.‬

9
00:00:39,300 --> 00:00:44,612
‫בִּשְׁתֵּי הָאֶפְשָׁרֻיּוֹת, גֹּבַהּ הַטַּבַּעַת 11.5 ס״מ:‬

10
00:00:44,662 --> 00:00:49,350
‫כֶּתֶר בְּגֹבַהּ 10 ס״מ, וּמִרְוָח שֶׁל 1.5 ס״מ.‬

11
00:00:50,000 --> 00:00:53,584
‫בַּגַּב הַשָּׁטוּחַ, הָעֹמֶק נִשְׁמָר עַד הַדְּפָנוֹת.‬

12
00:00:53,634 --> 00:00:57,720
‫בַּכִּפָּה, הַקֻּפְסָה רְדוּדָה יוֹתֵר לְיַד הַדְּפָנוֹת.‬

13
00:00:58,700 --> 00:01:04,510
‫בְּקִנּוּן, הַטַּבַּעַת שֶׁל הַיְּחִידָה הַתַּחְתּוֹנָה נִכְנֶסֶת לֶחָרִיץ שֶׁל הַיְּחִידָה שֶׁמֵּעָלֶיהָ.‬

14
00:01:05,200 --> 00:01:09,051
‫חָרִיץ צַר מְחַיֵּב דְּפָנוֹת כִּמְעַט זְקוּפוֹת,‬

15
00:01:09,101 --> 00:01:13,730
‫וְלָכֵן הַמִּרְוָח בֵּין הַיְּחִידוֹת גָּדֵל לְ־49 מ״מ.‬

16
00:01:14,100 --> 00:01:16,145
‫גַּם כְּשֶׁהָאֲרִיזוֹת הֲפוּכוֹת,‬

17
00:01:16,195 --> 00:01:20,380
‫הַטַּבַּעַת הָעֶלְיוֹנָה נִכְנֶסֶת לֶחָרִיץ שֶׁמִּתַּחְתֶּיהָ.‬

18
00:01:27,600 --> 00:01:33,514
‫הַגַּב הַשָּׁטוּחַ: מַרְאֶה נָקִי שֶׁל חָרִיץ אֶחָד, וְנֶפַח פְּנִימִי גָּדוֹל.‬

19
00:01:33,564 --> 00:01:39,400
‫הַחִסָּרוֹן: הַקֻּפְסָה עֲמֻקָּה בְּכָל שִׁטְחָהּ, וּדְרוּשׁ יוֹתֵר חֹמֶר.‬

20
00:01:39,800 --> 00:01:45,096
‫הַכִּפָּה: צוּרָה רַכָּה, פָּחוֹת חֹמֶר, וְאֵזוֹר שׁוּלַיִם רָדוּד.‬

21
00:01:45,146 --> 00:01:51,700
‫הַחִסָּרוֹן: הַמֶּרְכָּז בּוֹלֵט, וְהֶחָרִיץ אֵינוֹ הַפְּרָט הַיָּחִיד בַּגַּב.‬

22
00:01:52,100 --> 00:01:56,371
‫בִּשְׁתֵּיהֶן, חָרִיץ צַר כָּל כָּךְ דּוֹרֵשׁ בְּדִיקַת יַצְרָן:‬

23
00:01:56,421 --> 00:01:59,980
‫הַיְּרִיעָה נִמְתַּחַת עַל לַהַב דַּק וְגָבוֹהַּ.‬

24
00:02:00,800 --> 00:02:03,437
‫וְעוֹד אֶפְשָׁרוּת, שׁוֹנָה לְגַמְרֵי:‬

25
00:02:03,487 --> 00:02:08,050
‫עֲרִיסָה בְּצוּרַת הַכּוֹבַע, בְּלִי טַבַּעַת וּבְלִי חָרִיץ.‬

26
00:02:09,200 --> 00:02:10,916
‫הַכֶּתֶר יוֹשֵׁב בְּכִיס מֶרְכָּזִי,‬

27
00:02:10,966 --> 00:02:15,090
‫וְהַשּׁוּלַיִם נִשְׁעָנִים עַל מִשְׁטָח שֶׁעוֹקֵב אַחֲרֵי הַקִּמּוּר שֶׁלָּהֶם.‬

28
00:02:25,800 --> 00:02:31,469
‫הַיִּתְרוֹנוֹת: הַשּׁוּלַיִם נִתְמָכִים לְכָל רָחְבָּם, הַיִּצּוּר פָּשׁוּט יוֹתֵר,‬

29
00:02:31,519 --> 00:02:34,800
‫וְהַקִּנּוּן הָדוּק, כְּ־10 מ״מ לַיְּחִידָה.‬

30
00:02:35,200 --> 00:02:40,747
‫הַחִסָּרוֹן: הָעֲרִיסָה מֻתְאֶמֶת לְמִדַּת כּוֹבַע וּלְצוּרַת שׁוּלַיִם מְסֻיֶּמֶת,‬

31
00:02:40,797 --> 00:02:43,340
‫וּמִבַּחוּץ רוֹאִים כִּיס בּוֹלֵט.‬

32
00:02:44,200 --> 00:02:46,463
‫כָּל הַבְּדִיקוֹת כָּאן נַעֲשׂוּ בְּמוֹדֶל,‬

33
00:02:46,513 --> 00:02:49,130
‫וְיֵשׁ לְאַמֵּת אוֹתָן עַל דֻּגְמָה פִיזִית.‬
